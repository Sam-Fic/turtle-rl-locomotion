<mujoco model="turtle">
  <compiler angle="radian" meshdir="./assets/" autolimits="true" />
  <option timestep="0.001" iterations="100" solver="Newton" tolerance="1e-10" />
  <size njmax="500" nconmax="100" />

  <default>
    <default class="turtle">
      <geom friction="0.6" margin="0.001" condim="1" />
      <joint damping="5.0" armature="0.1" frictionloss="0.5" actuatorfrcrange="-100 100" />
      <default class="leg_joint">
        <joint axis="0 0 1" />
      </default>
      <default class="thigh_joint">
        <joint />
      </default>
      <default class="calf_joint">
        <joint />
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" />
      </default>
      <default class="collision">
        <geom type="mesh" group="3" />
      </default>
      <default class="foot">
        <geom type="mesh" group="3" friction="0.8 0.02 0.01" condim="6" solimp="0.015 1 0.031" />
      </default>
    </default>
  </default>

  <asset>
    <mesh name="base_link" file="base_link.STL" />
    <mesh name="link1" file="link1.STL" />
